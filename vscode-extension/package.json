{
  "name": "privacy-scanner-lgpd",
  "displayName": "Privacy Scanner LGPD",
  "description": "Análise estática de indícios técnicos de risco à privacidade conforme LGPD e Privacy by Design",
  "version": "1.1.0",
  "author": "TCC FATEC",
  "license": "MIT",
  "publisher": "fatec-tcc",
  "repository": {
    "type": "git",
    "url": "https://github.com/ViniciusDean/TCC-privacy-by-design"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Security"
  ],
  "keywords": [
    "privacy",
    "lgpd",
    "security",
    "technical-indicators",
    "pyd"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:python",
    "onLanguage:java",
    "onCommand:privacy-scanner.analyzeNow",
    "onCommand:privacy-scanner.analyze",
    "onCommand:privacy-scanner.analyzeAll",
    "onCommand:privacy-scanner.analyzeDatabase",
    "onCommand:privacy-scanner.clearResults",
    "onCommand:privacy-scanner.exportReport",
    "onCommand:privacy-scanner.exportHTML",
    "onCommand:privacy-scanner.exportJSON",
    "onCommand:privacy-scanner.showSidebar",
    "onCommand:privacy-scanner.ignoreVulnerability",
    "onCommand:privacy-scanner.restoreIgnoredVulnerabilities",
    "onCommand:privacy-scanner.createProfile",
    "onCommand:privacy-scanner.selectProfile",
    "onCommand:privacy-scanner.validateProfile",
    "onCommand:privacy-scanner.restartBackend",
    "onCommand:privacy-scanner.setupBackend",
    "onCommand:privacy-scanner.showLogs"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "privacy-scanner.analyzeNow",
        "title": "Privacy Scanner: Analisar agora",
        "category": "Privacy Scanner",
        "icon": "$(refresh)"
      },
      {
        "command": "privacy-scanner.analyze",
        "title": "Privacy Scanner: Analisar arquivo atual",
        "category": "Privacy Scanner"
      },
      {
        "command": "privacy-scanner.analyzeAll",
        "title": "Privacy Scanner: Analisar projeto inteiro",
        "category": "Privacy Scanner"
      },
      {
        "command": "privacy-scanner.analyzeDatabase",
        "title": "Privacy Scanner: Analisar banco SQLite",
        "category": "Privacy Scanner"
      },
      {
        "command": "privacy-scanner.clearResults",
        "title": "Privacy Scanner: Limpar resultados",
        "category": "Privacy Scanner",
        "icon": "$(clear-all)"
      },
      {
        "command": "privacy-scanner.exportReport",
        "title": "Privacy Scanner: Exportar relatorio",
        "category": "Privacy Scanner",
        "icon": "$(export)"
      },
      {
        "command": "privacy-scanner.exportHTML",
        "title": "Privacy Scanner: Exportar relatório HTML",
        "category": "Privacy Scanner"
      },
      {
        "command": "privacy-scanner.exportJSON",
        "title": "Privacy Scanner: Exportar relatório JSON",
        "category": "Privacy Scanner"
      },
      {
        "command": "privacy-scanner.showSidebar",
        "title": "Privacy Scanner: Mostrar achados",
        "category": "Privacy Scanner"
      },
      {
        "command": "privacy-scanner.ignoreVulnerability",
        "title": "Privacy Scanner: Ocultar achado na interface",
        "category": "Privacy Scanner",
        "icon": "$(eye-closed)"
      },
      {
        "command": "privacy-scanner.restoreIgnoredVulnerabilities",
        "title": "Privacy Scanner: Restaurar achados ocultados",
        "category": "Privacy Scanner",
        "icon": "$(eye)"
      },
      {
        "command": "privacy-scanner.createProfile",
        "title": "Privacy Scanner: Criar perfil do projeto",
        "category": "Privacy Scanner"
      },
      {
        "command": "privacy-scanner.selectProfile",
        "title": "Privacy Scanner: Selecionar perfil",
        "category": "Privacy Scanner"
      },
      {
        "command": "privacy-scanner.validateProfile",
        "title": "Privacy Scanner: Validar perfil",
        "category": "Privacy Scanner"
      },
      {
        "command": "privacy-scanner.restartBackend",
        "title": "Privacy Scanner: Reiniciar backend",
        "category": "Privacy Scanner"
      },
      {
        "command": "privacy-scanner.setupBackend",
        "title": "Privacy Scanner: Configurar dependencias do backend",
        "category": "Privacy Scanner"
      },
      {
        "command": "privacy-scanner.showLogs",
        "title": "Privacy Scanner: Mostrar logs",
        "category": "Privacy Scanner"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "privacy-scanner-sidebar",
          "title": "Privacy Scanner",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "privacy-scanner-sidebar": [
        {
          "id": "privacy-scanner-vulnerabilities",
          "name": "Achados",
          "when": "privacy-scanner:showVulnerabilities"
        },
        {
          "id": "privacy-scanner-summary",
          "name": "Resumo",
          "when": "privacy-scanner:showSummary"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "privacy-scanner.analyzeNow",
          "when": "view == privacy-scanner-vulnerabilities",
          "group": "navigation@1"
        },
        {
          "command": "privacy-scanner.exportReport",
          "when": "view == privacy-scanner-vulnerabilities",
          "group": "navigation@2"
        },
        {
          "command": "privacy-scanner.clearResults",
          "when": "view == privacy-scanner-vulnerabilities",
          "group": "navigation@3"
        },
        {
          "command": "privacy-scanner.restoreIgnoredVulnerabilities",
          "when": "view == privacy-scanner-vulnerabilities",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "privacy-scanner.ignoreVulnerability",
          "when": "view == privacy-scanner-vulnerabilities && viewItem == vulnerability",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "privacy-scanner.ignoreVulnerability",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Privacy Scanner",
      "properties": {
        "privacy-scanner.serverPort": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "maximum": 65535,
          "description": "Porta do servidor Flask para análise"
        },
        "privacy-scanner.autoAnalyzeOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Analisar arquivo automaticamente ao salvar"
        },
        "privacy-scanner.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Caminho para o executável Python (ex: python, python3, /usr/bin/python)"
        },
        "privacy-scanner.enableSidebar": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar sidebar com achados técnicos"
        },
        "privacy-scanner.showDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar achados técnicos no painel Problems"
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": ".privacy-scanner.json",
        "url": "./resources/profile.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run prepare-backend && npm run check-backend-version -- --bundled-only && npm run compile && npm run bundle",
    "prepare-backend": "node ./scripts/prepare-backend.js",
    "check-backend-version": "node ./scripts/check-backend-version.js",
    "package": "vsce package",
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --sourcemap",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run check-backend-version && npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/contract.test.js && node ./out/test/profile.test.js && node ./out/test/processUtils.test.js && node ./out/test/analysisCoordinator.test.js && node ./out/test/findingState.test.js && node ./out/test/httpClient.test.js && node ./out/test/backendEndpoint.test.js",
    "test:integration": "npm run prepare-backend && npm run compile && node ./scripts/run-integration-tests.js",
    "test:vsix": "node ./scripts/smoke-install-vsix.js",
    "test:all": "npm test && npm run test:integration"
  },
  "devDependencies": {
    "@types/node": "^14.0.0",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^4.0.0",
    "@typescript-eslint/parser": "^4.0.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.28.1",
    "eslint": "^7.0.0",
    "typescript": "^4.0.0"
  },
  "dependencies": {
    "axios": "^1.4.0"
  }
}
